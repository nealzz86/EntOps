                                <TextBlock Text="目标可填 IP 或域名，留空则用默认网关；参数框：「端口扫描」填端口（如 80,443 或 1-1024），「并发会话测试」填「端口,并发数」（如 9100,50），「Ping 测试」填次数。"
                                           Margin="0,6,0,8" FontSize="13" TextWrapping="Wrap"
                                           Foreground="{DynamicResource MainForegroundColor}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="目标：" VerticalAlignment="Center" Foreground="{DynamicResource MainForegroundColor}"/>
                                    <TextBox Name="WPFFNetTarget" Width="240" VerticalContentAlignment="Center" Margin="0,0,10,0"
                                             Text="" ToolTip="留空则使用默认网关"/>
                                    <TextBlock Text="参数：" VerticalAlignment="Center" Foreground="{DynamicResource MainForegroundColor}"/>
                                    <TextBox Name="WPFFNetArg" Width="120" VerticalContentAlignment="Center" Margin="0,0,10,0" Text="4"/>
                                </StackPanel>
                                <WrapPanel>
                                    <Button Name="WPFFNetPing" Content="Ping 测试" FontSize="{DynamicResource ConfigTabButtonFontSize}" Padding="14,8" Margin="0,0,8,6"/>
                                    <Button Name="WPFFNetTrace" Content="路由追踪" FontSize="{DynamicResource ConfigTabButtonFontSize}" Padding="14,8" Margin="0,0,8,6"/>
                                    <Button Name="WPFFNetPortScan" Content="端口扫描" FontSize="{DynamicResource ConfigTabButtonFontSize}" Padding="14,8" Margin="0,0,8,6"/>
                                    <Button Name="WPFFNetSession" Content="并发会话测试" FontSize="{DynamicResource ConfigTabButtonFontSize}" Padding="14,8" Margin="0,0,8,6"/>
                                    <Button Name="WPFFNetWan" Content="外网测速" FontSize="{DynamicResource ConfigTabButtonFontSize}" Padding="14,8" Margin="0,0,8,6"/>
                                    <Button Name="WPFFNetResolve" Content="DNS 解析" FontSize="{DynamicResource ConfigTabButtonFontSize}" Padding="14,8" Margin="0,0,8,6"/>
                                    <Button Name="WPFFNetDnsBenchmark" Content="DNS 测速" FontSize="{DynamicResource ConfigTabButtonFontSize}" Padding="14,8" Margin="0,0,8,6"/>
                                    <Button Name="WPFFNetPorts" Content="本机端口占用" FontSize="{DynamicResource ConfigTabButtonFontSize}" Padding="14,8" Margin="0,0,8,6"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- 网段扫描与安全体检 -->
                        <Border Style="{StaticResource BorderStyle}" Padding="16" Margin="5,5,5,10">
                            <StackPanel>
                                <TextBlock Text="本网段资产与安全体检" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource MainForegroundColor}"/>
                                <TextBlock Text="用于信息部对本单位网段的设备盘点与暴露面自查，请勿用于未授权网段。"
                                           Margin="0,6,0,8" FontSize="13" TextWrapping="Wrap"
                                           Foreground="{DynamicResource MainForegroundColor}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="网段：" VerticalAlignment="Center" Foreground="{DynamicResource MainForegroundColor}"/>
                                    <TextBox Name="WPFFNetSubnet" Width="180" VerticalContentAlignment="Center" Margin="0,0,10,0" ToolTip="留空则自动取本机 IPv4 所在 /24 网段"/>
                                    <TextBlock Text="内网测速共享路径：" VerticalAlignment="Center" Foreground="{DynamicResource MainForegroundColor}"/>
                                    <TextBox Name="WPFFNetLanPath" Width="260" VerticalContentAlignment="Center" ToolTip="例如 \\server\share 或已映射的盘符 S:\，需写入权限"/>
                                </StackPanel>
                                <WrapPanel>
                                    <Button Name="WPFFNetHosts" Content="主机发现" FontSize="{DynamicResource ConfigTabButtonFontSize}" Padding="14,8" Margin="0,0,8,6"/>
                                    <Button Name="WPFFNetCamera" Content="摄像头/IPC 扫描" FontSize="{DynamicResource ConfigTabButtonFontSize}" Padding="14,8" Margin="0,0,8,6"/>
                                    <Button Name="WPFFNetDhcp" Content="DHCP 检测" FontSize="{DynamicResource ConfigTabButtonFontSize}" Padding="14,8" Margin="0,0,8,6"/>
                                    <Button Name="WPFFNetAudit" Content="本机安全自测" FontSize="{DynamicResource ConfigTabButtonFontSize}" Padding="14,8" Margin="0,0,8,6"/>
                                    <Button Name="WPFFNetLan" Content="内网共享测速" FontSize="{DynamicResource ConfigTabButtonFontSize}" Padding="14,8" Margin="0,0,8,6"/>
                                    <Button Name="WPFFNetEvents" Content="网络事件日志" FontSize="{DynamicResource ConfigTabButtonFontSize}" Padding="14,8" Margin="0,0,8,6"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- 抓包与协议分析 -->
                        <Border Style="{StaticResource BorderStyle}" Padding="16" Margin="5,5,5,10">
                            <StackPanel>
                                <TextBlock Text="抓包与协议分析（系统内置 pktmon）" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource MainForegroundColor}"/>
                                <TextBlock Text="无需安装任何组件：开始抓包后复现问题，停止即生成按协议/端口汇总的会话统计，并保留 etl 原始文件供深入分析。抓包需要管理员权限，本工具启动时会自动申请。"
                                           Margin="0,6,0,8" FontSize="13" TextWrapping="Wrap"
                                           Foreground="{DynamicResource MainForegroundColor}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="过滤端口（可选）：" VerticalAlignment="Center" Foreground="{DynamicResource MainForegroundColor}"/>
                                    <TextBox Name="WPFFNetPktFilter" Width="200" VerticalContentAlignment="Center" Margin="0,0,10,0" ToolTip="例如 445,3389；留空抓全部"/>
                                    <TextBlock Text="时长秒（0=手动停止）：" VerticalAlignment="Center" Foreground="{DynamicResource MainForegroundColor}"/>
                                    <TextBox Name="WPFFNetPktSeconds" Width="70" VerticalContentAlignment="Center" Text="0"/>
                                </StackPanel>
                                <WrapPanel>
                                    <Button Name="WPFFNetPktStart" Content="开始抓包" FontSize="{DynamicResource ConfigTabButtonFontSize}" Padding="14,8" Margin="0,0,8,6"/>
                                    <Button Name="WPFFNetPktStop" Content="停止并分析" FontSize="{DynamicResource ConfigTabButtonFontSize}" Padding="14,8" Margin="0,0,8,6"/>
                                    <Button Name="WPFFNetPktOpen" Content="打开抓包目录" FontSize="{DynamicResource ConfigTabButtonFontSize}" Padding="14,8" Margin="0,0,8,6"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- 网络工具集 -->
                        <Border Style="{StaticResource BorderStyle}" Padding="16" Margin="5,5,5,10">
                            <StackPanel>
                                <TextBlock Text="网络工具集（全部离线计算）" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource MainForegroundColor}"/>
                                <TextBlock Text="填好某一行右侧的输入框，点该行的按钮即可，结果显示在下方「扫描结果」列表。只有「IP 冲突检测」「ARP 查询」「远程唤醒」会访问网络，其余都是本地换算，不联网、不上传。"
                                           Margin="0,6,0,8" FontSize="13" TextWrapping="Wrap"
                                           Foreground="{DynamicResource MainForegroundColor}"/>

                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="IP 地址计算器" FontSize="14" FontWeight="Bold" Background="Transparent" Foreground="{DynamicResource MainForegroundColor}"/>
                                        <TextBlock Text="掩码/CIDR 互转、网络地址、广播、可用范围" FontSize="11" TextWrapping="Wrap" Background="Transparent" Opacity="0.7" Foreground="{DynamicResource MainForegroundColor}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox Name="WPFFNetToolIpCalcIn" Width="300" VerticalContentAlignment="Center" ToolTip="例：192.168.1.20/24，或 192.168.1.20 255.255.255.0，或只填掩码 255.255.252.0"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Name="WPFFNetToolIpCalc" Content="计算" VerticalAlignment="Center" FontSize="{DynamicResource ConfigTabButtonFontSize}" Padding="14,8"/>
                                </Grid>

                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="子网划分（VLSM）" FontSize="14" FontWeight="Bold" Background="Transparent" Foreground="{DynamicResource MainForegroundColor}"/>
                                        <TextBlock Text="按各部门实际主机数分配子网，不浪费地址" FontSize="11" TextWrapping="Wrap" Background="Transparent" Opacity="0.7" Foreground="{DynamicResource MainForegroundColor}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox Name="WPFFNetToolVlsmIn" Width="200" VerticalContentAlignment="Center" Margin="0,0,8,0" ToolTip="基网段，例：192.168.1.0/24"/>
                                        <TextBox Name="WPFFNetToolVlsmIn2" Width="200" VerticalContentAlignment="Center" ToolTip="各段主机数，例：60,30,20,10；留空则均分"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Name="WPFFNetToolVlsm" Content="划分" VerticalAlignment="Center" FontSize="{DynamicResource ConfigTabButtonFontSize}" Padding="14,8"/>
                                </Grid>

                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="子网汇总" FontSize="14" FontWeight="Bold" Background="Transparent" Foreground="{DynamicResource MainForegroundColor}"/>
                                        <TextBlock Text="把多条网段折成最少的路由/ACL" FontSize="11" TextWrapping="Wrap" Background="Transparent" Opacity="0.7" Foreground="{DynamicResource MainForegroundColor}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox Name="WPFFNetToolSummaryIn" Width="408" VerticalContentAlignment="Center" ToolTip="例：192.168.0.0/24,192.168.1.0/24,192.168.2.0/24"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Name="WPFFNetToolSummary" Content="汇总" VerticalAlignment="Center" FontSize="{DynamicResource ConfigTabButtonFontSize}" Padding="14,8"/>
                                </Grid>

                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="MAC 地址工具" FontSize="14" FontWeight="Bold" Background="Transparent" Foreground="{DynamicResource MainForegroundColor}"/>
                                        <TextBlock Text="四种写法互转 + OUI 厂商查询（离线表）" FontSize="11" TextWrapping="Wrap" Background="Transparent" Opacity="0.7" Foreground="{DynamicResource MainForegroundColor}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox Name="WPFFNetToolMacIn" Width="300" VerticalContentAlignment="Center" ToolTip="例：00-1C-42-1A-2B-3C / 00:1c:42:1a:2b:3c / 001c.421a.2b3c / 001c421a2b3c"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Name="WPFFNetToolMac" Content="转换" VerticalAlignment="Center" FontSize="{DynamicResource ConfigTabButtonFontSize}" Padding="14,8"/>
                                </Grid>

                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="IP 冲突检测" FontSize="14" FontWeight="Bold" Background="Transparent" Foreground="{DynamicResource MainForegroundColor}"/>
                                        <TextBlock Text="地址是否已被占用、一个 MAC 是否占了两个 IP" FontSize="11" TextWrapping="Wrap" Background="Transparent" Opacity="0.7" Foreground="{DynamicResource MainForegroundColor}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox Name="WPFFNetToolConflictIn" Width="300" VerticalContentAlignment="Center" ToolTip="要检测的 IP，可逗号分隔多个；留空则检测本机现有地址"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Name="WPFFNetToolConflict" Content="检测" VerticalAlignment="Center" FontSize="{DynamicResource ConfigTabButtonFontSize}" Padding="14,8"/>
                                </Grid>

                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="ARP 查询" FontSize="14" FontWeight="Bold" Background="Transparent" Foreground="{DynamicResource MainForegroundColor}"/>
                                        <TextBlock Text="IP 与 MAC 双向查本机邻居表" FontSize="11" TextWrapping="Wrap" Background="Transparent" Opacity="0.7" Foreground="{DynamicResource MainForegroundColor}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox Name="WPFFNetToolArpIn" Width="300" VerticalContentAlignment="Center" ToolTip="填 IP 查 MAC，或填 MAC 反查 IP"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Name="WPFFNetToolArp" Content="查询" VerticalAlignment="Center" FontSize="{DynamicResource ConfigTabButtonFontSize}" Padding="14,8"/>
                                </Grid>

                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="远程唤醒（Wake-on-LAN）" FontSize="14" FontWeight="Bold" Background="Transparent" Foreground="{DynamicResource MainForegroundColor}"/>
                                        <TextBlock Text="向网卡发魔术包开机；需目标机 BIOS/网卡已开 WOL" FontSize="11" TextWrapping="Wrap" Background="Transparent" Opacity="0.7" Foreground="{DynamicResource MainForegroundColor}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox Name="WPFFNetToolWolIn" Width="200" VerticalContentAlignment="Center" Margin="0,0,8,0" ToolTip="目标网卡 MAC"/>
                                        <TextBox Name="WPFFNetToolWolIn2" Width="200" VerticalContentAlignment="Center" ToolTip="发往的地址（留空自动用子网广播），可带端口，例：192.168.1.255,7"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Name="WPFFNetToolWol" Content="发送" VerticalAlignment="Center" FontSize="{DynamicResource ConfigTabButtonFontSize}" Padding="14,8"/>
                                </Grid>

                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="带宽计算器" FontSize="14" FontWeight="Bold" Background="Transparent" Foreground="{DynamicResource MainForegroundColor}"/>
                                        <TextBlock Text="多大的文件走多快的线要多久，赶时间要多大带宽" FontSize="11" TextWrapping="Wrap" Background="Transparent" Opacity="0.7" Foreground="{DynamicResource MainForegroundColor}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox Name="WPFFNetToolBwIn" Width="160" VerticalContentAlignment="Center" Margin="0,0,8,0" ToolTip="文件大小，例：2.5G、800MB、1200（按 MB）"/>
                                        <TextBox Name="WPFFNetToolBwIn2" Width="240" VerticalContentAlignment="Center" ToolTip="链路带宽，例：千兆、1000M、1G、100MB/s；留空则列出常见链路"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Name="WPFFNetToolBw" Content="计算" VerticalAlignment="Center" FontSize="{DynamicResource ConfigTabButtonFontSize}" Padding="14,8"/>
                                </Grid>

                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="VLAN 规划器" FontSize="14" FontWeight="Bold" Background="Transparent" Foreground="{DynamicResource MainForegroundColor}"/>
                                        <TextBlock Text="一批 VLAN 对应的子网、网关与可用主机数" FontSize="11" TextWrapping="Wrap" Background="Transparent" Opacity="0.7" Foreground="{DynamicResource MainForegroundColor}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox Name="WPFFNetToolVlanIn" Width="160" VerticalContentAlignment="Center" Margin="0,0,8,0" ToolTip="VLAN 号或范围，例：10-18"/>
                                        <TextBox Name="WPFFNetToolVlanIn2" Width="240" VerticalContentAlignment="Center" ToolTip="编号基址（1~3 段），例：10.10 → 每 VLAN 一个 10.10.&lt;VLAN&gt;.0/24"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Name="WPFFNetToolVlan" Content="规划" VerticalAlignment="Center" FontSize="{DynamicResource ConfigTabButtonFontSize}" Padding="14,8"/>
                                </Grid>

                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="MTU 计算器" FontSize="14" FontWeight="Bold" Background="Transparent" Foreground="{DynamicResource MainForegroundColor}"/>
                                        <TextBlock Text="扣掉头/隧道开销后还剩多少数据，反推需要多大 MTU" FontSize="11" TextWrapping="Wrap" Background="Transparent" Opacity="0.7" Foreground="{DynamicResource MainForegroundColor}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox Name="WPFFNetToolMtuIn" Width="160" VerticalContentAlignment="Center" Margin="0,0,8,0" ToolTip="链路 MTU，例：1500 或 9000；留空按 1500"/>
                                        <TextBox Name="WPFFNetToolMtuIn2" Width="240" VerticalContentAlignment="Center" ToolTip="要一次装下的 TCP 数据字节数，例：1400"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Name="WPFFNetToolMtu" Content="计算" VerticalAlignment="Center" FontSize="{DynamicResource ConfigTabButtonFontSize}" Padding="14,8"/>
                                </Grid>

                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="STP 优先级计算" FontSize="14" FontWeight="Bold" Background="Transparent" Foreground="{DynamicResource MainForegroundColor}"/>
                                        <TextBlock Text="生成树桥优先级 + VLAN 组成的桥 ID，谁当根桥" FontSize="11" TextWrapping="Wrap" Background="Transparent" Opacity="0.7" Foreground="{DynamicResource MainForegroundColor}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox Name="WPFFNetToolStpIn" Width="160" VerticalContentAlignment="Center" Margin="0,0,8,0" ToolTip="优先级，例：4096、8192、32768（必须 4096 的倍数）"/>
                                        <TextBox Name="WPFFNetToolStpIn2" Width="240" VerticalContentAlignment="Center" ToolTip="VLAN ID，例：10（1~4094，默认 1）"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Name="WPFFNetToolStp" Content="计算" VerticalAlignment="Center" FontSize="{DynamicResource ConfigTabButtonFontSize}" Padding="14,8"/>
                                </Grid>

                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="进制转换" FontSize="14" FontWeight="Bold" Background="Transparent" Foreground="{DynamicResource MainForegroundColor}"/>
                                        <TextBlock Text="2/8/10/16 进制与点分地址互转" FontSize="11" TextWrapping="Wrap" Background="Transparent" Opacity="0.7" Foreground="{DynamicResource MainForegroundColor}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox Name="WPFFNetToolRadixIn" Width="300" VerticalContentAlignment="Center" ToolTip="例：500、0x1F4、1F4h、111110100b、10.0.0.1"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Name="WPFFNetToolRadix" Content="转换" VerticalAlignment="Center" FontSize="{DynamicResource ConfigTabButtonFontSize}" Padding="14,8"/>
                                </Grid>

                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="速率单位转换" FontSize="14" FontWeight="Bold" Background="Transparent" Foreground="{DynamicResource MainForegroundColor}"/>
                                        <TextBlock Text="Mbps 与 MB/s 之间差 8 倍，这里一次算清" FontSize="11" TextWrapping="Wrap" Background="Transparent" Opacity="0.7" Foreground="{DynamicResource MainForegroundColor}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox Name="WPFFNetToolRateIn" Width="300" VerticalContentAlignment="Center" ToolTip="例：100M、1Gbps、500Kbps、12.5MB/s"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Name="WPFFNetToolRate" Content="转换" VerticalAlignment="Center" FontSize="{DynamicResource ConfigTabButtonFontSize}" Padding="14,8"/>
                                </Grid>

                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="时间戳转换" FontSize="14" FontWeight="Bold" Background="Transparent" Foreground="{DynamicResource MainForegroundColor}"/>
                                        <TextBlock Text="Unix 秒/毫秒与本地时间互转，排日志用" FontSize="11" TextWrapping="Wrap" Background="Transparent" Opacity="0.7" Foreground="{DynamicResource MainForegroundColor}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox Name="WPFFNetToolTimeIn" Width="300" VerticalContentAlignment="Center" ToolTip="例：1761458400、1761458400000 或 2026-10-26 14:30:00；留空取当前时间"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Name="WPFFNetToolTime" Content="转换" VerticalAlignment="Center" FontSize="{DynamicResource ConfigTabButtonFontSize}" Padding="14,8"/>
                                </Grid>

                                <TextBlock Text="OUI 厂商表：离线环境只带内置精简表（虚拟机/容器/常见监控设备）。需要完整表时，把 IEEE 的 oui.txt 放到程序目录 tools\net\oui.txt；用 exe 版时程序目录是解包缓存，改放 %LOCALAPPDATA%\winutil\tools\net\oui.txt，本工具会自动读取。"
                                           Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" Background="Transparent" Opacity="0.75"
                                           Foreground="{DynamicResource MainForegroundColor}"/>
                            </StackPanel>
                        </Border>

                        <!-- 结果与输出 -->
                        <Border Style="{StaticResource BorderStyle}" Padding="16" Margin="5,5,5,10">
                            <StackPanel>
                                <TextBlock Text="扫描结果" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"
                                           Background="Transparent" Foreground="{DynamicResource MainForegroundColor}"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300" Margin="0,0,0,10">
                                    <StackPanel Name="WPFFNetResults"/>
                                </ScrollViewer>
                                <TextBlock Text="过程输出" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"
                                           Background="Transparent" Foreground="{DynamicResource MainForegroundColor}"/>
                                <TextBox Name="WPFFNetOutput" IsReadOnly="True" TextWrapping="Wrap"
                                         FontFamily="Consolas" VerticalScrollBarVisibility="Auto" MaxHeight="320"
                                         Background="Transparent" Foreground="{DynamicResource MainForegroundColor}" BorderThickness="1"
                                         Text="就绪。点击上方任一功能开始诊断。"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource BorderStyle}" Margin="5,5,5,5">
                            <TextBlock Padding="10" TextWrapping="Wrap" Foreground="{DynamicResource MainForegroundColor}">
                                说明：全部诊断在本机完成，只使用 Windows 自带命令与 API，不联网上传任何数据；离线环境下「外网测速」不可用，可改用「内网共享测速」。
                                <LineBreak/>抓包文件保存在 %LOCALAPPDATA%\winutil\captures，仅包含经过本机网卡的报文。如有问题请联系信息部。
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Window-level progress indicator - visible regardless of active tab -->
        <Border Name="WPFTweaksProgressBar" Grid.Row="3" Background="{DynamicResource MainBackgroundColor}" Visibility="Collapsed" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <TextBlock Name="WPFTweaksProgressLabel" Text="" Foreground="{DynamicResource MainForegroundColor}" FontSize="13" Background="Transparent" Margin="0,0,0,4"/>
                    <ProgressBar Name="WPFTweaksProgressValue" Height="6" Minimum="0" Maximum="100" Value="0" Style="{StaticResource RoundedProgressBarStyle}"/>
                </StackPanel>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</Window>
